# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
DB_POOL_MAX=15

# Authentication
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3002

# Passkey Configuration
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Kosarica App

# Logging
LOG_LEVEL=info
NODE_OPTIONS=--enable-source-maps

# Release metadata
APP_VERSION=0.1.0
APP_RELEASE=0.1.0+local
BUILD_ENV=development

# Ingestion - comma-separated chain IDs to process on scheduled runs
INGESTION_CHAINS=
INGESTION_FILE_CONCURRENCY=4
INGESTION_DB_BATCH_SIZE=1000
INGESTION_PROGRESS_UPDATE_INTERVAL_MS=5000
INGESTION_ITEM_WRITE_SHARDS=3
INGESTION_ITEM_WRITE_BATCH_SIZE=500
INGESTION_ITEM_WRITE_RETRY_MAX=5
INGESTION_ITEM_WRITE_RETRY_BASE_MS=50
INGESTION_PARQUET_MAX_PENDING_WRITES=3

# Task Queue Worker
WORKER_MAX_TASKS=8
WORKER_POLL_DELAY_MS=2000

# Storage Configuration
STORAGE_PATH=./data/storage
TEMP_STORAGE_PATH=./data/temp
TEMP_FILE_RETENTION_HOURS=48

# ClickHouse Configuration
CLICKHOUSE_URL=http://localhost:8123

# LLM Ensemble (required for semantic clustering pipeline)
# Ordered model list: first model is primary, second is verifier, third is tie-breaker.
LLM_ENSEMBLE_JSON=[{"id":"fast","provider":"openrouter","model":"openai/gpt-4o-mini","apiKeyEnv":"OPENROUTER_API_KEY","weight":1.0,"timeoutMs":20000,"maxRetries":1},{"id":"verify","provider":"openrouter","model":"google/gemini-1.5-flash","apiKeyEnv":"OPENROUTER_API_KEY","weight":1.2,"timeoutMs":20000,"maxRetries":1},{"id":"tie-break","provider":"claude","model":"claude-3-5-sonnet-20241022","apiKeyEnv":"ANTHROPIC_API_KEY","weight":1.5,"timeoutMs":30000,"maxRetries":1}]
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenTelemetry Configuration
# Set to empty string to disable telemetry export
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=kosarica-nodejs

# PostHog (client-side, optional)
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=0.05

# Future Ads Conversion (keep disabled until launch)
ADS_CONVERSION_ENABLED=false
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
