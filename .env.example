# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
DB_POOL_MAX=15

# Authentication
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3002

# Passkey Configuration
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Kosarica App

# Logging
LOG_LEVEL=info
NODE_OPTIONS=--enable-source-maps

# Release metadata
APP_VERSION=0.1.0
APP_RELEASE=0.1.0+local
BUILD_ENV=development

# Ingestion - comma-separated chain IDs to process on scheduled runs
INGESTION_CHAINS=
INGESTION_FILE_CONCURRENCY=4
INGESTION_DB_BATCH_SIZE=1000
INGESTION_PROGRESS_UPDATE_INTERVAL_MS=5000
INGESTION_ITEM_WRITE_SHARDS=3
INGESTION_ITEM_WRITE_BATCH_SIZE=500
INGESTION_ITEM_WRITE_RETRY_MAX=5
INGESTION_ITEM_WRITE_RETRY_BASE_MS=50
INGESTION_PARQUET_MAX_PENDING_WRITES=3

# Task Queue Worker
WORKER_MAX_TASKS=8
WORKER_POLL_DELAY_MS=2000

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
TEMP_STORAGE_PATH=./data/temp
TEMP_FILE_RETENTION_HOURS=48
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ClickHouse Configuration
CLICKHOUSE_URL=http://localhost:8123
# Import strategy:
# - http: upload parquet bytes via HTTP POST
# - infile: server-side file() reads from ClickHouse user_files mount
CLICKHOUSE_IMPORT_MODE=http
# user_files subdirectory where STORAGE_PATH is mounted in ClickHouse container
CLICKHOUSE_USER_FILES_SUBDIR=storage
# Per-file parquet import timeout for ClickHouse sync (ms)
CLICKHOUSE_IMPORT_TIMEOUT_MS=1800000

# LLM endpoints are DB-managed via llm_endpoints + llm_endpoint_capabilities.
# API keys referenced by DB records must still exist in env.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NIM_API_KEY=
ZAI_API_KEY=
VERTEX_EXPRESS_API_KEY=
VERTEX_EXPRESS_RPM=10

# Catalog enhancement (categorization)
# CATEGORIZATION_RPM_LIMIT=10
# CATEGORIZATION_BATCH_SIZE=30
# CATEGORIZATION_BACKFILL_CONCURRENCY=10
# CATEGORIZATION_CONFIDENCE_THRESHOLD=0.8

# Unified matching tuning (listwise pipeline used by /admin/matching)
UNIFIED_MATCHING_MAX_GROUP_SIZE=45

# Vertex AI Express keys can be referenced by llm_endpoints rows.

# OpenTelemetry Configuration
# Set to empty string to disable telemetry export
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=kosarica-nodejs

# PostHog (client-side, optional)
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=0.05

# Future Ads Conversion (keep disabled until launch)
ADS_CONVERSION_ENABLED=false
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
