# Development Environment Configuration
# This file is committed to git for shared development setup
# Vite automatically loads .env.development when NODE_ENV=development

# Database - Postgres via OrbStack DNS
DATABASE_URL=postgresql://kosarica:kosarica@ade-postgres.orb.local:5432/kosarica
DB_POOL_MAX=15

# Authentication
BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3002

# Dev ports (frontend uses PORT=3002 by default in development)
PORT=3002

# Service Account API Key (for programmatic access — real key goes in .env.local)
SERVICE_ACCOUNT_API_KEY=

# Passkey Configuration
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME="Kosarica App"

# Logging
LOG_LEVEL=info
NODE_OPTIONS=--enable-source-maps

# Release metadata
APP_VERSION=0.1.0
APP_RELEASE=0.1.0+dev
BUILD_ENV=development

# Ingestion - comma-separated chain IDs to process on scheduled runs
INGESTION_CHAINS=
INGESTION_FILE_CONCURRENCY=4
INGESTION_ITEM_WRITE_SHARDS=3
INGESTION_PARQUET_MAX_PENDING_WRITES=3

# Task Queue Worker
WORKER_MAX_TASKS=8
WORKER_POLL_DELAY_MS=2000

# Storage Configuration
STORAGE_PATH=./data/storage
TEMP_STORAGE_PATH=./data/temp
TEMP_FILE_RETENTION_HOURS=48

# ClickHouse Configuration - via OrbStack DNS
CLICKHOUSE_URL=http://ade-clickhouse.orb.local:8123

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=kosarica-nodejs

# PostHog (optional in development)
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=0.05

# Semantic clustering LLM (Z.ai OpenAI-compatible API)
ZAI_API_KEY=
LOCAL_LLM_API_KEY=
LLM_ENSEMBLE_JSON='[{"id":"ministral","provider":"openai","model":"mistralai/ministral-3-3b","endpoint":"http://host.docker.internal:1234/v1/chat/completions","apiKeyEnv":"LOCAL_LLM_API_KEY","weight":1.0,"timeoutMs":60000,"maxRetries":1},{"id":"qwen3-4b","provider":"openai","model":"qwen/qwen3-4b-2507","endpoint":"http://host.docker.internal:1234/v1/chat/completions","apiKeyEnv":"LOCAL_LLM_API_KEY","weight":1.0,"timeoutMs":60000,"maxRetries":1},{"id":"qwen3-8b","provider":"openai","model":"qwen/qwen3-8b","endpoint":"http://host.docker.internal:1234/v1/chat/completions","apiKeyEnv":"LOCAL_LLM_API_KEY","responseFormat":"none","weight":1.0,"timeoutMs":90000,"maxRetries":1},{"id":"deepseek-8b","provider":"openai","model":"deepseek/deepseek-r1-0528-qwen3-8b","endpoint":"http://host.docker.internal:1234/v1/chat/completions","apiKeyEnv":"LOCAL_LLM_API_KEY","responseFormat":"none","weight":1.0,"timeoutMs":120000,"maxRetries":1},{"id":"qwen3-30b-a3b","provider":"openai","model":"qwen/qwen3-30b-a3b","endpoint":"http://host.docker.internal:1234/v1/chat/completions","apiKeyEnv":"LOCAL_LLM_API_KEY","responseFormat":"json_schema","jsonSchemaNullable":true,"maxTokens":2000,"weight":1.0,"timeoutMs":240000,"maxRetries":1},{"id":"gpt-oss-20b","provider":"openai","model":"openai/gpt-oss-20b","endpoint":"http://host.docker.internal:1234/v1/chat/completions","apiKeyEnv":"LOCAL_LLM_API_KEY","responseFormat":"none","maxTokens":2000,"weight":1.0,"timeoutMs":240000,"maxRetries":1}]'

# Semantic clustering LLM (OpenRouter)
OPENROUTER_API_KEY=
# Example single-model OpenRouter ensemble:
# LLM_ENSEMBLE_JSON='[{"id":"or-primary","provider":"openrouter","model":"openai/gpt-4o-mini","apiKeyEnv":"OPENROUTER_API_KEY","weight":1.0,"timeoutMs":30000,"maxRetries":1}]'
