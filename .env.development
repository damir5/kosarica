# Development Environment Configuration
# This file is committed to git for shared development setup
# Vite automatically loads .env.development when NODE_ENV=development

# Database - Postgres via OrbStack DNS
DATABASE_URL=postgresql://kosarica:kosarica@ade-postgres.orb.local:5432/kosarica
DB_POOL_MAX=15

# Authentication
BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3002

# Dev ports (frontend uses PORT=3002 by default in development)
PORT=3002

# Passkey Configuration
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME="Kosarica App"

# Logging
LOG_LEVEL=info
NODE_OPTIONS=--enable-source-maps

# Release metadata
APP_VERSION=0.1.0
APP_RELEASE=0.1.0+dev
BUILD_ENV=development

# Ingestion - comma-separated chain IDs to process on scheduled runs
INGESTION_CHAINS=
INGESTION_FILE_CONCURRENCY=4
INGESTION_ITEM_WRITE_SHARDS=3
INGESTION_PARQUET_MAX_PENDING_WRITES=3

# Task Queue Worker
WORKER_MAX_TASKS=8
WORKER_POLL_DELAY_MS=2000

# Storage Configuration
STORAGE_PATH=./data/storage
TEMP_STORAGE_PATH=./data/temp
TEMP_FILE_RETENTION_HOURS=48

# ClickHouse Configuration - via OrbStack DNS
CLICKHOUSE_URL=http://ade-clickhouse.orb.local:8123

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=kosarica-nodejs

# PostHog (optional in development)
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=0.05
