# Price Service Configuration
# All configuration is done through environment variables.
# Copy this file to .env and modify as needed.

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
HOST=0.0.0.0
# Server timeouts (duration format: 30s, 1m, etc.)
# PRICE_SERVICE_SERVER_READ_TIMEOUT=30s
# PRICE_SERVICE_SERVER_WRITE_TIMEOUT=30s

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Connection pool settings
PRICE_SERVICE_DATABASE_MAX_CONNECTIONS=10
PRICE_SERVICE_DATABASE_MIN_CONNECTIONS=2
# PRICE_SERVICE_DATABASE_MAX_CONN_LIFETIME=1h
# PRICE_SERVICE_DATABASE_MAX_CONN_IDLE_TIME=30m

# =============================================================================
# Rate Limiting
# =============================================================================
PRICE_SERVICE_RATE_LIMIT_REQUESTS_PER_SECOND=2
PRICE_SERVICE_RATE_LIMIT_MAX_RETRIES=3
# PRICE_SERVICE_RATE_LIMIT_INITIAL_BACKOFF_MS=100
# PRICE_SERVICE_RATE_LIMIT_MAX_BACKOFF_MS=30000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_NO_COLOR=false

# =============================================================================
# Storage
# =============================================================================
# Storage type: "local" or "s3"
# STORAGE_TYPE=local
STORAGE_PATH=./data/archives

# S3 storage (when STORAGE_TYPE=s3)
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_PREFIX=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_FORCE_PATH_STYLE=false

# =============================================================================
# Security
# =============================================================================
# Extra CA certs (optional, for sites that omit intermediates)
EXTRA_CA_CERTS_FILE=./config/certs/plodine-extra-ca.pem

# Internal API Key for service-to-service authentication
# Generate a secure random key for production
INTERNAL_API_KEY=dev-internal-api-key-change-in-production
