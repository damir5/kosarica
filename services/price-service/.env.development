# Development env for price-service (committed)
# Use simple PORT so it matches frontend dev usage
PORT=3003
HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://kosarica:kosarica@localhost:5432/kosarica
PRICE_SERVICE_DATABASE_MAX_CONNECTIONS=10
PRICE_SERVICE_DATABASE_MIN_CONNECTIONS=2

# Storage
STORAGE_PATH=./data/archives

# Extra CA certs (some sites omit intermediates)
EXTRA_CA_CERTS_FILE=./config/certs/plodine-extra-ca.pem

# Internal API Key for service-to-service authentication
# Keep this in sync with the root .env.development so tests and the
# NodeJS process use the same key when mise runs `test-all`.
INTERNAL_API_KEY=dev-internal-api-key-change-in-development
