{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kosarica.local/knowledge/alerts-history.schema.json",
  "type": "object",
  "required": ["_meta", "entries"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "updated_at", "updated_by", "description"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "updated_by": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "severity", "metric", "value", "threshold", "message"],
        "properties": {
          "at": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["warning", "critical"] },
          "metric": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "threshold": { "type": "number" },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
