{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kosarica.local/knowledge/equivalence.schema.json",
  "type": "object",
  "required": ["_meta", "equivalences"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["version", "updated_at", "updated_by", "description"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "format": "date-time" },
        "updated_by": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "equivalences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_key", "items"],
        "properties": {
          "canonical_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
          },
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["chain", "name_pattern"],
              "properties": {
                "chain": {
                  "type": "string",
                  "enum": [
                    "konzum",
                    "lidl",
                    "plodine",
                    "interspar",
                    "kaufland",
                    "studenac",
                    "eurospin",
                    "dm",
                    "ktc",
                    "metro",
                    "trgocentar"
                  ]
                },
                "name_pattern": { "type": "string", "minLength": 1 },
                "barcode": {
                  "type": "string",
                  "pattern": "^[0-9]{8,14}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
